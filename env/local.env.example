# Copy this file to env/local.env for local development overrides.
# Do not commit env/*.env files.

# Public gateway ports. Use non-privileged ports locally when 80/443 are occupied.
HTTP_PORT=8081
HTTPS_PORT=8444

# Local-only observability ports.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Grafana admin account.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus local retention window.
PROMETHEUS_RETENTION=15d

# Alertmanager config file. Use a local file when enabling real email alerts.
ALERTMANAGER_CONFIG=./observability/alertmanager/alertmanager.yml
