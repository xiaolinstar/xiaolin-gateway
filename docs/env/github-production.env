# GitHub L2 本地清单（仓库级 Secrets）
# 复制到：
#   ~/.config/xiaolinstar/xiaolin-gateway/github-production.env
#
# 注意：真实文件不要提交到 Git。

GITHUB_REPOSITORY=xiaolinstar/xiaolin-gateway

# Required：CD SSH 连接 gateway VPS（101.34.78.2）
SERVER_HOST=101.34.78.2
SERVER_USER=ubuntu
SERVER_PASSWORD=change-me

# 同步：
#   bash scripts/cd/sync-github-env.sh --dry-run
#   bash scripts/cd/sync-github-env.sh
