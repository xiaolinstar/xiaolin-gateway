# 121 colocate overlay: same-host ai-todo compose on :8082.
# Mounted over ai-todo.conf via docker-compose.121.yml (file bind wins).

upstream ai-todo-api {
    server host.docker.internal:8082;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name xingxiaolin.cn www.xingxiaolin.cn;

    ssl_certificate /etc/nginx/cert/ai-todo/xingxiaolin.cn.pem;
    ssl_certificate_key /etc/nginx/cert/ai-todo/xingxiaolin.cn.key;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/host.access.log main;

    location / {
        proxy_pass http://ai-todo-api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
