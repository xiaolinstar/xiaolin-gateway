# Copy this file to .env.local for local-only overrides.
# Load order: .env, then .env.local for local development.

# Local compose: gateway only (no Prometheus/Grafana by default).
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Public gateway ports. Use non-privileged ports locally when 80/443 are occupied.
HTTP_PORT=8880
HTTPS_PORT=8443

# ai-todo local upstream (K8s LoadBalancer or port-forward on host :8082).
AI_TODO_UPSTREAM_HOST=host.docker.internal
AI_TODO_UPSTREAM_PORT=8082
# Local vhost server_name is ai-todo-api.localhost (see app/ai-todo/ai-todo.local.overlay).

# Optional: enable observability locally — either append to COMPOSE_FILE:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml:observability-compose.yml
# or run with explicit composition files:
#   docker compose --env-file .env --env-file .env.local -f docker-compose.yml -f docker-compose.local.yml -f observability-compose.yml up -d
#
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# ALERTMANAGER_CONFIG=./observability/alertmanager/alertmanager.local.yml
