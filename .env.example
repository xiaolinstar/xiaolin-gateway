# Copy this file to .env on the server and adjust values for that environment.

# Compose files to merge. CD rewrites per Environment (tencent-101 / aliyun-121).
# tencent-101 default (observability on):
COMPOSE_FILE=docker-compose.yml:docker-compose.tencent-101.yml:observability-compose.yml
# aliyun-121 default (observability off):
# COMPOSE_FILE=docker-compose.yml:docker-compose.aliyun-121.yml
# Optional override: GitHub Environment Variable ENABLE_OBSERVABILITY=true|false


# Public gateway ports.
HTTP_PORT=80
HTTPS_PORT=443

# Observability ports (only used when observability-compose.yml is loaded).
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Grafana admin account.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus local retention window.
PROMETHEUS_RETENTION=15d

# Alertmanager config file. Use a local file when enabling real email alerts.
ALERTMANAGER_CONFIG=./observability/alertmanager/alertmanager.yml
