# Copy this file to .env.production on the server for production-only overrides.
# Load order in CD: .env, then .env.production.

# Production gateway ports normally stay public.
HTTP_PORT=80
HTTPS_PORT=443

# tencent-101 production default (CD rewrites per target + ENABLE_OBSERVABILITY).
COMPOSE_FILE=docker-compose.yml:docker-compose.tencent-101.yml:observability-compose.yml
# aliyun-121 default without observability:
# COMPOSE_FILE=docker-compose.yml:docker-compose.aliyun-121.yml

# Observability ports (only used when observability-compose.yml is in COMPOSE_FILE).
# Bound to 127.0.0.1 in observability-compose.yml.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Use the production Alertmanager config when real notifications are enabled.
ALERTMANAGER_CONFIG=./observability/alertmanager/alertmanager.prod.yaml
